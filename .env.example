# Копируется в .env локально. В репозиторий .env не коммитится.
# Здесь только ИМЕНА переменных и безопасные значения для локальной разработки.
# Реальные ключи живут в секрет-хранилище среды — агентам их значения не показывают.

# --- API ---
API_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hermes
POSTGRES_USER=hermes
POSTGRES_PASSWORD=hermes_local_only

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_BUCKET=hermes-artifacts
S3_ACCESS_KEY_ID=minio_local_only
S3_SECRET_ACCESS_KEY=minio_local_only

# --- Провайдеры генерации видео ---
# Значения не коммитятся никогда. В CI и тестах используется мок-провайдер.
VIDEO_PROVIDER=mock
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_TIMEOUT_MS=180000
VIDEO_PROVIDER_MAX_CONCURRENCY=2

# --- budget-guard ---
BUDGET_PER_JOB_MINOR=15000
BUDGET_PER_ORDER_MINOR=60000
BUDGET_PER_DAY_MINOR=500000
BUDGET_CURRENCY=RUB

# --- ffmpeg ---
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFMPEG_TIMEOUT_MS=600000
