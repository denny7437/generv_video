{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@hermes/domain": ["packages/domain/src/index.ts"],
      "@hermes/budget-guard": ["packages/budget-guard/src/index.ts"],
      "@hermes/worker-assembly": ["services/worker-assembly/src/index.ts"],
      "@hermes/worker-qc": ["services/worker-qc/src/index.ts"],
      "@hermes/worker-render": ["services/worker-render/src/index.ts"],
      "@hermes/worker-import": ["services/worker-import/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "services/*/src/**/*.ts",
    "apps/api/src/**/*.ts",
    "scripts/**/*.mjs",
    "vitest.config.ts",
    "eslint.config.mjs"
  ],
  "exclude": ["node_modules", "**/node_modules"]
}
